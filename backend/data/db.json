            "lat": 36.4593,
            "lng": 25.4775
          },
          {
            "day_number": 4,
            "title": "Volcanic Beaches & Hot Springs",
            "summary": "Explore the unique black sand beaches of Perissa or Kamari and take a rejuvenating boat trip to the volcanic hot springs.",
            "lat": 36.3996,
            "lng": 25.4806
          },
          {
            "day_number": 5,
            "title": "Pyrgos Village & Wine Tasting",
